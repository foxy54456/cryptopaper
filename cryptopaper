#!/usr/bin/env bash

set -euo pipefail

PRICE_API="https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cryptopaper"
PRICE_CACHE="$CACHE_DIR/market.json"

DEFAULT_UPDATE_TIME="2m"

OUTPUT=""

GREEN="#00c853"
RED="#ff5252"
WHITE="#ffffff"
BACKGROUND="#090909"
GRAY="#aaaaaa"

COMMAND="${1:-help}"
TIME_RANGE="${2:-1d}"
UPDATE_TIME="${3:-$DEFAULT_UPDATE_TIME}"

RANGE_LABEL="${TIME_RANGE^^}"

# Base resolution used when designing the wallpaper layout.
BASE_WIDTH=1920
BASE_HEIGHT=1080

# These are automatically detected before generating the wallpaper.
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080


get_days() {
    if [[ "$TIME_RANGE" =~ ^([1-9][0-9]*)d$ ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "Invalid time range: $TIME_RANGE" >&2
        echo "Use something like: 1d, 7d, 16d, 30d" >&2
        return 1
    fi
}


parse_update_time() {
    local value="$1"

    if [[ "$value" =~ ^([1-9][0-9]*)(s|m|h)$ ]]; then
        local amount="${BASH_REMATCH[1]}"
        local unit="${BASH_REMATCH[2]}"

        case "$unit" in
            s)
                echo "$amount"
                ;;
            m)
                echo $(( amount * 60 ))
                ;;
            h)
                echo $(( amount * 3600 ))
                ;;
        esac
    else
        echo "Invalid update time: $value" >&2
        echo "Use something like: 30s, 2m, 10m, 1h" >&2
        return 1
    fi
}


format_update_time() {
    local seconds="$1"

    if (( seconds % 3600 == 0 )); then
        local hours=$(( seconds / 3600 ))

        if (( hours == 1 )); then
            echo "1 hour"
        else
            echo "$hours hours"
        fi

    elif (( seconds % 60 == 0 )); then
        local minutes=$(( seconds / 60 ))

        if (( minutes == 1 )); then
            echo "1 minute"
        else
            echo "$minutes minutes"
        fi

    else
        if (( seconds == 1 )); then
            echo "1 second"
        else
            echo "$seconds seconds"
        fi
    fi
}


format_age() {
    local seconds="$1"

    if (( seconds < 60 )); then
        echo "${seconds}s"

    elif (( seconds < 3600 )); then
        echo "$(( seconds / 60 ))m"

    elif (( seconds < 86400 )); then
        echo "$(( seconds / 3600 ))h"

    else
        echo "$(( seconds / 86400 ))d"
    fi
}


validate_args() {
    case "$COMMAND" in
        price)
            if (( $# != 1 )); then
                echo "Usage: ./cryptopaper price" >&2
                exit 1
            fi
            ;;

        set)
            if (( $# > 2 )); then
                echo "Usage: ./cryptopaper set [days]" >&2
                exit 1
            fi

            get_days >/dev/null || exit 1
            ;;

        run)
            if (( $# > 3 )); then
                echo "Usage: ./cryptopaper run [days] [update-time]" >&2
                exit 1
            fi

            get_days >/dev/null || exit 1
            parse_update_time "$UPDATE_TIME" >/dev/null || exit 1
            ;;

        cache|clear-cache)
            if (( $# != 1 )); then
                echo "Usage: ./cryptopaper $COMMAND" >&2
                exit 1
            fi
            ;;

        help|--help|-h)
            ;;

        *)
            ;;
    esac
}


get_screen_dimensions() {
    local size=""

    # Debug command:
    # CRYPTOPAPER_RESOLUTION=2560x1440 ./cryptopaper set
    if [[ -n "${CRYPTOPAPER_RESOLUTION:-}" ]]; then
        if [[ "$CRYPTOPAPER_RESOLUTION" =~ ^([0-9]+)x([0-9]+)$ ]]; then
            SCREEN_WIDTH="${BASH_REMATCH[1]}"
            SCREEN_HEIGHT="${BASH_REMATCH[2]}"
            return
        else
            echo "Invalid CRYPTOPAPER_RESOLUTION: $CRYPTOPAPER_RESOLUTION" >&2
            return 1
        fi
    fi

    SCREEN_WIDTH="$BASE_WIDTH"
    SCREEN_HEIGHT="$BASE_HEIGHT"

    if command -v kscreen-doctor >/dev/null 2>&1; then
        size="$(
            kscreen-doctor -o 2>/dev/null |
            awk '
                /Geometry:/ {
                    if (match($0, /[0-9]+x[0-9]+/)) {
                        print substr($0, RSTART, RLENGTH)
                        exit
                    }
                }
            '
        )"
    fi

    if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        SCREEN_WIDTH="${BASH_REMATCH[1]}"
        SCREEN_HEIGHT="${BASH_REMATCH[2]}"
    fi

    if (( SCREEN_WIDTH <= 0 || SCREEN_HEIGHT <= 0 )); then
        SCREEN_WIDTH="$BASE_WIDTH"
        SCREEN_HEIGHT="$BASE_HEIGHT"
    fi
}


scale_x() {
    local value="$1"

    awk \
        -v value="$value" \
        -v width="$SCREEN_WIDTH" \
        -v base="$BASE_WIDTH" \
        'BEGIN {
            result = int((value * width / base) + 0.5)

            if (result < 1) {
                result = 1
            }

            print result
        }'
}


scale_y() {
    local value="$1"

    awk \
        -v value="$value" \
        -v height="$SCREEN_HEIGHT" \
        -v base="$BASE_HEIGHT" \
        'BEGIN {
            result = int((value * height / base) + 0.5)

            if (result < 1) {
                result = 1
            }

            print result
        }'
}


scale_font() {
    local value="$1"

    awk \
        -v value="$value" \
        -v width="$SCREEN_WIDTH" \
        -v height="$SCREEN_HEIGHT" \
        -v base_width="$BASE_WIDTH" \
        -v base_height="$BASE_HEIGHT" \
        'BEGIN {
            x_scale = width / base_width
            y_scale = height / base_height

            if (x_scale < y_scale) {
                scale = x_scale
            } else {
                scale = y_scale
            }

            result = int((value * scale) + 0.5)

            if (result < 1) {
                result = 1
            }

            print result
        }'
}


get_cache_seconds() {
    local mode="${1:-}"

    if [[ "$mode" == "run" ]]; then
        parse_update_time "$UPDATE_TIME"
    else
        echo 120
    fi
}


get_price_json() {
    local mode="${1:-}"
    local cache_seconds
    local age

    cache_seconds="$(get_cache_seconds "$mode")"

    mkdir -p "$CACHE_DIR"

    if [[ -f "$PRICE_CACHE" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$PRICE_CACHE") ))

        if (( age < cache_seconds )); then
            cat "$PRICE_CACHE"
            return
        fi
    fi

    if curl -fsS "$PRICE_API" -o "$PRICE_CACHE.tmp"; then
        if jq -e '.bitcoin.usd' "$PRICE_CACHE.tmp" >/dev/null 2>&1; then
            mv "$PRICE_CACHE.tmp" "$PRICE_CACHE"
            cat "$PRICE_CACHE"
            return
        fi

        rm -f "$PRICE_CACHE.tmp"
    fi

    if [[ -f "$PRICE_CACHE" ]]; then
        echo "Price API unavailable, using cached data." >&2
        cat "$PRICE_CACHE"
        return
    fi

    echo "Could not fetch Bitcoin price." >&2
    return 1
}


get_price() {
    local mode="${1:-}"
    local response
    local price

    response="$(get_price_json "$mode")" || return 1

    price="$(printf '%s' "$response" | jq -r '.bitcoin.usd // empty')"

    if [[ -z "$price" ]]; then
        echo "Could not get Bitcoin price." >&2
        return 1
    fi

    printf '%.2f\n' "$price"
}


get_chart_file() {
    local mode="${1:-}"

    local days
    local chart_cache
    local cache_seconds
    local age
    local count

    days="$(get_days)"
    chart_cache="$CACHE_DIR/chart-${days}d.json"
    cache_seconds="$(get_cache_seconds "$mode")"

    mkdir -p "$CACHE_DIR"

    if [[ -f "$chart_cache" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$chart_cache") ))

        if (( age < cache_seconds )); then
            printf '%s\n' "$chart_cache"
            return
        fi
    fi

    if curl -fsS \
        "https://api.coingecko.com/api/v3/coins/bitcoin/market_chart?vs_currency=usd&days=${days}" \
        -o "$chart_cache.tmp"
    then
        count="$(jq '.prices | length' "$chart_cache.tmp")"

        if [[ "$count" =~ ^[0-9]+$ ]] && (( count >= 2 )); then
            mv "$chart_cache.tmp" "$chart_cache"
            printf '%s\n' "$chart_cache"
            return
        fi

        rm -f "$chart_cache.tmp"
    fi

    if [[ -f "$chart_cache" ]]; then
        echo "Chart API unavailable, using cached ${days}d data." >&2
        printf '%s\n' "$chart_cache"
        return
    fi

    echo "Could not fetch chart data." >&2
    return 1
}


get_chart_data() {
    local mode="${1:-}"
    local chart_file

    chart_file="$(get_chart_file "$mode")" || return 1

    jq -r '.prices[][1]' "$chart_file"
}


get_range_change() {
    local mode="${1:-}"

    local chart_file
    local first_price
    local last_price

    chart_file="$(get_chart_file "$mode")" || return 1

    first_price="$(jq -r '.prices[0][1]' "$chart_file")"
    last_price="$(jq -r '.prices[-1][1]' "$chart_file")"

    awk \
        -v first="$first_price" \
        -v last="$last_price" \
        'BEGIN {
            if (first == 0) {
                exit 1
            }

            print ((last - first) / first) * 100
        }'
}


get_change_color() {
    local change="$1"

    awk \
        -v change="$change" \
        -v green="$GREEN" \
        -v red="$RED" \
        'BEGIN {
            if (change >= 0) {
                print green
            } else {
                print red
            }
        }'
}


format_change() {
    local change="$1"

    awk -v change="$change" 'BEGIN {
        if (change >= 0) {
            printf "+%.2f%%\n", change
        } else {
            printf "%.2f%%\n", change
        }
    }'
}


make_graph_draw_args() {
    local mode="${1:-}"

    local -a prices
    local -a args=()

    local min
    local max

    local width
    local height
    local start_x
    local start_y
    local stroke_width

    local count
    local i

    local price
    local prev_price

    local x1
    local x2
    local y1
    local y2

    local color

    width="$(scale_x 1400)"
    height="$(scale_y 260)"
    start_x="$(scale_x 260)"
    start_y="$(scale_y 660)"
    stroke_width="$(scale_font 4)"

    mapfile -t prices < <(get_chart_data "$mode")

    count="${#prices[@]}"

    if (( count < 2 )); then
        return 1
    fi

    min="$(
        printf '%s\n' "${prices[@]}" |
        sort -n |
        head -n 1
    )"

    max="$(
        printf '%s\n' "${prices[@]}" |
        sort -n |
        tail -n 1
    )"

    price_to_y() {
        awk \
            -v price="$1" \
            -v min="$min" \
            -v max="$max" \
            -v start="$start_y" \
            -v height="$height" \
            'BEGIN {
                if (max == min) {
                    print start
                } else {
                    print int(start + height - ((price - min) / (max - min) * height))
                }
            }'
    }

    for (( i=1; i<count; i++ )); do
        prev_price="${prices[$((i - 1))]}"
        price="${prices[$i]}"

        x1=$(( start_x + ((i - 1) * width / (count - 1)) ))
        x2=$(( start_x + (i * width / (count - 1)) ))

        y1="$(price_to_y "$prev_price")"
        y2="$(price_to_y "$price")"

        color="$(
            awk \
                -v curr="$price" \
                -v prev="$prev_price" \
                -v green="$GREEN" \
                -v red="$RED" \
                'BEGIN {
                    if (curr >= prev) {
                        print green
                    } else {
                        print red
                    }
                }'
        )"

        args+=(
            -stroke "$color"
            -strokewidth "$stroke_width"
            -fill none
            -draw "line ${x1},${y1} ${x2},${y2}"
        )
    done

    printf '%s\0' "${args[@]}"
}


show_price() {
    local price

    price="$(get_price)"

    printf 'Bitcoin: $%s\n' "$price"
}


show_cache() {
    local now
    local age
    local found_chart=false
    local file
    local name

    now="$(date +%s)"

    echo "cryptopaper cache"
    echo

    if [[ ! -d "$CACHE_DIR" ]]; then
        echo "No cache directory exists yet."
        return
    fi

    if [[ -f "$PRICE_CACHE" ]]; then
        age=$(( now - $(stat -c %Y "$PRICE_CACHE") ))

        echo "Price:"
        echo "  market.json — $(format_age "$age") old"
    else
        echo "Price:"
        echo "  not cached"
    fi

    echo
    echo "Charts:"

    while IFS= read -r file; do
        found_chart=true

        age=$(( now - $(stat -c %Y "$file") ))
        name="$(basename "$file")"

        echo "  $name — $(format_age "$age") old"
    done < <(
        find "$CACHE_DIR" \
            -maxdepth 1 \
            -type f \
            -name 'chart-*d.json' \
            -print 2>/dev/null |
        sort
    )

    if [[ "$found_chart" == false ]]; then
        echo "  no chart data cached"
    fi

    echo
    echo "Cache directory:"
    echo "  $CACHE_DIR"
}


clear_cache() {
    mkdir -p "$CACHE_DIR"

    rm -f \
        "$PRICE_CACHE" \
        "$PRICE_CACHE.tmp"

    find "$CACHE_DIR" \
        -maxdepth 1 \
        -type f \
        \( \
            -name 'chart-*d.json' \
            -o -name 'chart-*d.json.tmp' \
        \) \
        -delete

    echo "Cryptopaper API cache cleared."
}


make_wallpaper() {
    local mode="${1:-}"

    local price
    local change
    local change_text
    local change_color

    local title_size
    local price_size
    local change_size
    local label_size

    local title_offset
    local price_offset
    local change_offset
    local label_offset

    local -a graph_args

    get_screen_dimensions

    OUTPUT="$CACHE_DIR/wallpaper-$(date +%s).png"

    price="$(get_price "$mode")"
    change="$(get_range_change "$mode")"

    change_text="$(format_change "$change")"
    change_color="$(get_change_color "$change")"

    mkdir -p "$CACHE_DIR"

    mapfile -d '' -t graph_args < <(make_graph_draw_args "$mode")

    if (( ${#graph_args[@]} == 0 )); then
        echo "Could not generate graph." >&2
        return 1
    fi

    title_size="$(scale_font 48)"
    price_size="$(scale_font 140)"
    change_size="$(scale_font 48)"
    label_size="$(scale_font 28)"

    title_offset="$(scale_y 120)"
    price_offset="$(scale_y 200)"
    change_offset="$(scale_y 90)"
    label_offset="$(scale_y 110)"

    magick \
        -size "${SCREEN_WIDTH}x${SCREEN_HEIGHT}" \
        "xc:${BACKGROUND}" \
        -gravity north \
        -fill "$WHITE" \
        -font DejaVu-Sans \
        -pointsize "$title_size" \
        -annotate "+0+${title_offset}" "BITCOIN" \
        -gravity center \
        -fill "$WHITE" \
        -font DejaVu-Sans \
        -pointsize "$price_size" \
        -annotate "+0-${price_offset}" "\$${price}" \
        -gravity center \
        -fill "$change_color" \
        -font DejaVu-Sans \
        -pointsize "$change_size" \
        -annotate "+0-${change_offset}" "$change_text" \
        "${graph_args[@]}" \
        -gravity south \
        -fill "$GRAY" \
        -stroke none \
        -font DejaVu-Sans \
        -pointsize "$label_size" \
        -annotate "+0+${label_offset}" "$RANGE_LABEL" \
        "$OUTPUT"

    printf 'Wallpaper saved to %s\n' "$OUTPUT"
    printf 'Resolution: %sx%s\n' "$SCREEN_WIDTH" "$SCREEN_HEIGHT"
}


set_wallpaper() {
    local mode="${1:-}"

    if ! command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
        echo "Could not find plasma-apply-wallpaperimage." >&2
        echo "This version currently supports KDE Plasma." >&2
        exit 1
    fi

    make_wallpaper "$mode"

    plasma-apply-wallpaperimage "$OUTPUT"

    find "$CACHE_DIR" \
        -name 'wallpaper-*.png' \
        -type f \
        -mmin +10 \
        -delete

    printf 'Wallpaper updated.\n'
}


run_wallpaper() {
    local update_seconds
    local update_label

    update_seconds="$(parse_update_time "$UPDATE_TIME")"
    update_label="$(format_update_time "$update_seconds")"

    echo "Starting cryptopaper..."
    echo "Range: $RANGE_LABEL"
    echo "Updating every $update_label."
    echo "Press Ctrl+C to stop."
    echo

    trap '
        echo
        echo "cryptopaper stopped."
        exit 0
    ' INT TERM

    while true; do
        if ! set_wallpaper "run"; then
            echo "Update failed. Retrying in $update_label." >&2
        fi

        sleep "$update_seconds"
    done
}


show_help() {
    echo "cryptopaper"
    echo
    echo "Usage:"
    echo "  ./cryptopaper price"
    echo "  ./cryptopaper set [days]"
    echo "  ./cryptopaper run [days] [update-time]"
    echo "  ./cryptopaper cache"
    echo "  ./cryptopaper clear-cache"
    echo
    echo "Commands:"
    echo "  price        Show the current Bitcoin price"
    echo "  set          Generate and set the wallpaper once"
    echo "  run          Keep the wallpaper automatically updated"
    echo "  cache        Show cached API data"
    echo "  clear-cache  Remove cached API data"
    echo
    echo "Examples:"
    echo "  ./cryptopaper price"
    echo "  ./cryptopaper set"
    echo "  ./cryptopaper set 7d"
    echo "  ./cryptopaper run"
    echo "  ./cryptopaper run 7d"
    echo "  ./cryptopaper run 1d 30s"
    echo "  ./cryptopaper run 7d 5m"
    echo "  ./cryptopaper cache"
    echo "  ./cryptopaper clear-cache"
    echo
    echo "Time range:"
    echo "  1d, 7d, 16d, 30d, etc."
    echo
    echo "Update time:"
    echo "  s = seconds"
    echo "  m = minutes"
    echo "  h = hours"
    echo
    echo "Default range: 1d"
    echo "Default update time: 2m"
    echo "Screen resolution: automatically detected"
    echo
    echo "Press Ctrl+C to stop the run command."
}


validate_args "$@"

case "$COMMAND" in
    price)
        show_price
        ;;

    set)
        set_wallpaper
        ;;

    run)
        run_wallpaper
        ;;

    cache)
        show_cache
        ;;

    clear-cache)
        clear_cache
        ;;

    help|--help|-h)
        show_help
        ;;

    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Run './cryptopaper help' for usage." >&2
        exit 1
        ;;
esac
