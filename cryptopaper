load_currency
validate_args "$@"

case "$COMMAND" in
    price)
        show_price
        ;;

    set)
        set_wallpaper
        ;;

    run)
        run_wallpaper
        ;;

    cur)
        set_currency "${2:-}"
        ;;

    info)
        show_info
        ;;

    cache)
        show_cache
        ;;

    clear-cache)
        clear_cache
        ;;

    help|--help|-h)
        show_help
        ;;

    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Run './cryptopaper help' for usage." >&2
        exit 1
        ;;
esac
