#!/usr/bin/env bash

set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cryptopaper"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cryptopaper"
CONFIG_FILE="$CONFIG_DIR/config"
SWAYBG_PID_FILE="$CACHE_DIR/swaybg.pid"

DEFAULT_CURRENCY="USD"
CURRENCY="$DEFAULT_CURRENCY"

DEFAULT_COIN="btc"

DEFAULT_UPDATE_TIME="2m"

OUTPUT=""

GREEN="#00c853"
RED="#ff5252"
WHITE="#ffffff"
BACKGROUND="#090909"
GRAY="#aaaaaa"

BASE_WIDTH=1920
BASE_HEIGHT=1080

SCREEN_WIDTH="$BASE_WIDTH"
SCREEN_HEIGHT="$BASE_HEIGHT"

COMMAND="${1:-__run__}"

COIN="$DEFAULT_COIN"
COIN_ID="bitcoin"
COIN_NAME="BITCOIN"

TIME_RANGE="1d"
UPDATE_TIME="$DEFAULT_UPDATE_TIME"
RANGE_LABEL="1D"


check_dependencies() {
    local -a missing=()
    local cmd

    for cmd in bash curl jq magick awk stat sort head find timeout mktemp; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if (( ${#missing[@]} > 0 )); then
        echo "cryptopaper: missing required dependencies:" >&2
        printf '  %s\n' "${missing[@]}" >&2
        return 1
    fi
}


get_currency_api_code() {
    printf '%s\n' "${CURRENCY,,}"
}


get_currency_symbol() {
    case "$CURRENCY" in
        USD) printf '$\n' ;;
        EUR) printf '€\n' ;;
        GBP) printf '£\n' ;;
    esac
}


set_currency() {
    local value="${1:-}"
    value="${value^^}"

    case "$value" in
        USD|EUR|GBP)
            ;;
        *)
            echo "Unsupported currency: ${value:-<empty>}" >&2
            echo "Supported currencies: USD, EUR, GBP" >&2
            return 1
            ;;
    esac

    CURRENCY="$value"
    save_config

    echo "Currency set to $CURRENCY ($(get_currency_symbol))."
}


set_coin() {
    local coin="${1,,}"

    case "$coin" in
        btc)
            COIN="btc"
            COIN_ID="bitcoin"
            COIN_NAME="BITCOIN"
            ;;

        eth)
            COIN="eth"
            COIN_ID="ethereum"
            COIN_NAME="ETHEREUM"
            ;;

        sol)
            COIN="sol"
            COIN_ID="solana"
            COIN_NAME="SOLANA"
            ;;

        doge)
            COIN="doge"
            COIN_ID="dogecoin"
            COIN_NAME="DOGECOIN"
            ;;

        xmr)
            COIN="xmr"
            COIN_ID="monero"
            COIN_NAME="MONERO"
            ;;

        bnb)
            COIN="bnb"
            COIN_ID="binancecoin"
            COIN_NAME="BNB"
            ;;

        xrp)
            COIN="xrp"
            COIN_ID="ripple"
            COIN_NAME="XRP"
            ;;

        *)
            echo "Unsupported coin: $1" >&2
            echo >&2
            echo "Supported coins:" >&2
            echo "  btc" >&2
            echo "  eth" >&2
            echo "  sol" >&2
            echo "  doge" >&2
            echo "  xmr" >&2
            echo "  bnb" >&2
            echo "  xrp" >&2
            return 1
            ;;
    esac
}


save_config() {
    mkdir -p "$CONFIG_DIR"
    local tmp_file
    tmp_file="$(mktemp "$CONFIG_FILE.tmp.XXXXXX")" || return 1

    {
        printf 'coin=%s\n' "$COIN"
        printf 'currency=%s\n' "$CURRENCY"
        printf 'range=%s\n' "$TIME_RANGE"
        printf 'interval=%s\n' "$UPDATE_TIME"
    } > "$tmp_file" && mv -f "$tmp_file" "$CONFIG_FILE" || {
        rm -f "$tmp_file"
        return 1
    }
}


load_config() {
    local saved_coin=""
    local saved_currency=""
    local saved_range=""
    local saved_interval=""

    local key value
    local -A seen=()
    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS='=' read -r key value || [[ -n "$key" ]]; do
            [[ -n "$key" ]] || continue
            [[ -z "${seen[$key]+present}" ]] || continue
            seen["$key"]=1
            case "$key" in
                coin) saved_coin="${value%%=*}" ;;
                currency) saved_currency="${value%%=*}" ;;
                range) saved_range="${value%%=*}" ;;
                interval) saved_interval="${value%%=*}" ;;
            esac
        done < "$CONFIG_FILE"
    fi

    if [[ -n "$saved_coin" ]]; then
        if ! set_coin "$saved_coin" >/dev/null 2>&1; then
            set_coin "$DEFAULT_COIN"
        fi
    else
        set_coin "$DEFAULT_COIN"
    fi

    saved_currency="${saved_currency^^}"

    case "$saved_currency" in
        USD|EUR|GBP)
            CURRENCY="$saved_currency"
            ;;
        *)
            CURRENCY="$DEFAULT_CURRENCY"
            ;;
    esac

    if [[ "$saved_range" =~ ^[1-9][0-9]*d$ ]]; then
        TIME_RANGE="$saved_range"
    else
        TIME_RANGE="1d"
    fi

    if [[ "$saved_interval" =~ ^[1-9][0-9]*(s|m|h)$ ]]; then
        UPDATE_TIME="$saved_interval"
    else
        UPDATE_TIME="$DEFAULT_UPDATE_TIME"
    fi
}


set_active_coin() {
    local value="${1:-}"

    set_coin "$value" || return 1
    save_config

    echo "Coin set to $COIN_NAME ($COIN)."
}


set_saved_range() {
    local value="${1:-}"

    if [[ ! "$value" =~ ^[1-9][0-9]*d$ ]]; then
        echo "Invalid time range: $value" >&2
        echo "Use something like: 1d, 7d, 16d, 30d" >&2
        return 1
    fi

    TIME_RANGE="$value"
    RANGE_LABEL="${TIME_RANGE^^}"
    save_config

    echo "Range set to $TIME_RANGE."
}


set_saved_interval() {
    local value="${1:-}"

    if [[ ! "$value" =~ ^[1-9][0-9]*(s|m|h)$ ]]; then
        echo "Invalid update time: $value" >&2
        echo "Use something like: 30s, 2m, 10m, 1h" >&2
        return 1
    fi

    UPDATE_TIME="$value"
    save_config

    echo "Update interval set to $UPDATE_TIME."
}


parse_cli_args() {
    case "$COMMAND" in
        __run__)
            if (( $# != 0 )); then
                echo "Usage: cryptopaper" >&2
                exit 1
            fi
            ;;

        price)
            if (( $# != 1 )); then
                echo "Usage: cryptopaper price" >&2
                exit 1
            fi
            ;;

        set)
            if (( $# > 2 )); then
                echo "Usage: cryptopaper set [days]" >&2
                exit 1
            fi

            if (( $# == 2 )); then
                TIME_RANGE="$2"
            fi
            ;;

        range)
            if (( $# != 2 )); then
                echo "Usage: cryptopaper range <days>" >&2
                exit 1
            fi
            ;;

        interval)
            if (( $# != 2 )); then
                echo "Usage: cryptopaper interval <time>" >&2
                exit 1
            fi
            ;;

        coin)
            if (( $# != 2 )); then
                echo "Usage: cryptopaper coin btc|eth|sol|doge|xmr|bnb|xrp" >&2
                exit 1
            fi
            ;;

        cur)
            if (( $# != 2 )); then
                echo "Usage: cryptopaper cur USD|EUR|GBP" >&2
                exit 1
            fi
            ;;

        cache|clear-cache|info)
            if (( $# != 1 )); then
                echo "Usage: cryptopaper $COMMAND" >&2
                exit 1
            fi
            ;;

        help|--help|-h)
            if (( $# != 1 )); then
                echo "Usage: cryptopaper help" >&2
                exit 1
            fi
            ;;

        *)
            # Positional auto-run shortcut:
            #   cryptopaper 3d
            #   cryptopaper 3d 45s
            # These update the saved run settings, then start the updater.
            if [[ "$COMMAND" =~ ^[1-9][0-9]*d$ ]]; then
                if (( $# > 2 )); then
                    echo "Usage: cryptopaper [days] [update-time]" >&2
                    exit 1
                fi

                TIME_RANGE="$COMMAND"

                if (( $# == 2 )); then
                    if ! parse_update_time "$2" >/dev/null; then
                        exit 1
                    fi
                    UPDATE_TIME="$2"
                fi

                COMMAND="__run__"
                RANGE_LABEL="${TIME_RANGE^^}"
                save_config
                return
            fi
            ;;
    esac

    RANGE_LABEL="${TIME_RANGE^^}"
}

get_days() {
    if [[ "$TIME_RANGE" =~ ^([1-9][0-9]*)d$ ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "Invalid time range: $TIME_RANGE" >&2
        echo "Use something like: 1d, 7d, 16d, 30d" >&2
        return 1
    fi
}


parse_update_time() {
    local value="$1"

    if [[ "$value" =~ ^([1-9][0-9]*)(s|m|h)$ ]]; then
        local amount="${BASH_REMATCH[1]}"
        local unit="${BASH_REMATCH[2]}"

        case "$unit" in
            s)
                echo "$amount"
                ;;

            m)
                echo $(( amount * 60 ))
                ;;

            h)
                echo $(( amount * 3600 ))
                ;;
        esac
    else
        echo "Invalid update time: $value" >&2
        echo "Use something like: 30s, 2m, 10m, 1h" >&2
        return 1
    fi
}


format_update_time() {
    local seconds="$1"

    if (( seconds % 3600 == 0 )); then
        local hours=$(( seconds / 3600 ))

        if (( hours == 1 )); then
            echo "1 hour"
        else
            echo "$hours hours"
        fi

    elif (( seconds % 60 == 0 )); then
        local minutes=$(( seconds / 60 ))

        if (( minutes == 1 )); then
            echo "1 minute"
        else
            echo "$minutes minutes"
        fi

    else
        if (( seconds == 1 )); then
            echo "1 second"
        else
            echo "$seconds seconds"
        fi
    fi
}


format_age() {
    local seconds="$1"

    if (( seconds < 60 )); then
        echo "${seconds}s"

    elif (( seconds < 3600 )); then
        echo "$(( seconds / 60 ))m"

    elif (( seconds < 86400 )); then
        echo "$(( seconds / 3600 ))h"

    else
        echo "$(( seconds / 86400 ))d"
    fi
}


validate_args() {
    case "$COMMAND" in
        __run__)
            get_days >/dev/null || exit 1
            parse_update_time "$UPDATE_TIME" >/dev/null || exit 1
            ;;

        set)
            get_days >/dev/null || exit 1
            ;;

        range)
            [[ "${2:-}" =~ ^[1-9][0-9]*d$ ]] || {
                echo "Invalid time range: ${2:-}" >&2
                echo "Use something like: 1d, 7d, 16d, 30d" >&2
                exit 1
            }
            ;;

        interval)
            parse_update_time "${2:-}" >/dev/null || exit 1
            ;;

        price|coin|cur|cache|clear-cache|info|help|--help|-h)
            ;;

        *)
            ;;
    esac
}


set_screen_size() {
    local width="$1"
    local height="$2"

    if (( width >= 640 && height >= 480 )); then
        SCREEN_WIDTH="$width"
        SCREEN_HEIGHT="$height"
        return 0
    fi

    return 1
}


get_screen_dimensions() {
    local size=""
    local desktop

    SCREEN_WIDTH="$BASE_WIDTH"
    SCREEN_HEIGHT="$BASE_HEIGHT"

    desktop="${XDG_CURRENT_DESKTOP:-}"
    desktop="${desktop^^}"

    #
    # Manual resolution override
    #
    if [[ -n "${CRYPTOPAPER_RESOLUTION:-}" ]]; then
        if [[ "$CRYPTOPAPER_RESOLUTION" =~ ^([0-9]+)x([0-9]+)$ ]]; then
            if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                return
            fi
        fi

        echo "Invalid CRYPTOPAPER_RESOLUTION: $CRYPTOPAPER_RESOLUTION" >&2
        return 1
    fi

    #
    # KDE Plasma
    #
    if [[ "$desktop" == *"KDE"* || "$desktop" == *"PLASMA"* ]]; then
        if command -v kscreen-doctor >/dev/null 2>&1; then
            size="$(
                timeout 2s kscreen-doctor -o 2>/dev/null |
                awk '
                    /Geometry:/ {
                        if (match($0, /[0-9]+x[0-9]+/)) {
                            print substr($0, RSTART, RLENGTH)
                            exit
                        }
                    }
                '
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    #
    # Hyprland
    #
    if [[ "$desktop" == *"HYPRLAND"* ||
          -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
    then
        if command -v hyprctl >/dev/null 2>&1; then
            size="$(
                timeout 2s hyprctl monitors -j 2>/dev/null |
                jq -r '
                    first(
                        .[] |
                        select(.focused == true) |
                        "\(.width)x\(.height)"
                    ) // empty
                ' 2>/dev/null
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    #
    # Sway
    #
    if [[ "$desktop" == *"SWAY"* ||
          -n "${SWAYSOCK:-}" ]]
    then
        if command -v swaymsg >/dev/null 2>&1; then
            size="$(
                timeout 2s swaymsg -t get_outputs -r 2>/dev/null |
                jq -r '
                    first(
                        .[] |
                        select(.focused == true) |
                        "\(.rect.width)x\(.rect.height)"
                    ) // empty
                ' 2>/dev/null
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    #
    # Generic X11
    #
    if [[ "${XDG_SESSION_TYPE:-}" == "x11" ]]; then
        if command -v xrandr >/dev/null 2>&1; then
            size="$(
                xrandr 2>/dev/null |
                awk '
                    / connected primary / {
                        if (match($0, /[0-9]+x[0-9]+\+/)) {
                            value = substr($0, RSTART, RLENGTH)
                            sub(/\+$/, "", value)
                            print value
                            exit
                        }
                    }

                    / connected / {
                        if (fallback == "" && match($0, /[0-9]+x[0-9]+\+/)) {
                            fallback = substr($0, RSTART, RLENGTH)
                            sub(/\+$/, "", fallback)
                        }
                    }

                    END {
                        if (fallback != "") {
                            print fallback
                        }
                    }
                ' |
                head -n 1
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi

        if command -v xdpyinfo >/dev/null 2>&1; then
            size="$(
                xdpyinfo 2>/dev/null |
                awk '/dimensions:/ { print $2; exit }'
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    SCREEN_WIDTH="$BASE_WIDTH"
    SCREEN_HEIGHT="$BASE_HEIGHT"
}


scale_x() {
    local result=$(( ($1 * SCREEN_WIDTH + BASE_WIDTH / 2) / BASE_WIDTH ))
    printf '%s\n' "$(( result < 1 ? 1 : result ))"
}


scale_y() {
    local result=$(( ($1 * SCREEN_HEIGHT + BASE_HEIGHT / 2) / BASE_HEIGHT ))
    printf '%s\n' "$(( result < 1 ? 1 : result ))"
}


scale_font() {
    if (( SCREEN_WIDTH * BASE_HEIGHT < SCREEN_HEIGHT * BASE_WIDTH )); then
        scale_x "$1"
    else
        scale_y "$1"
    fi
}

get_cache_seconds() {
    local mode="${1:-}"

    if [[ "$mode" == "run" ]]; then
        parse_update_time "$UPDATE_TIME"
    else
        echo 120
    fi
}


get_price_cache_file() {
    printf '%s/%s-market-%s.json\n' \
        "$CACHE_DIR" \
        "$COIN" \
        "${CURRENCY,,}"
}


get_price_json() {
    local mode="${1:-}"

    local cache_seconds
    local age
    local api_currency
    local price_api
    local price_cache
    local tmp_file
    local http_code

    api_currency="$(get_currency_api_code)"

    price_api="https://api.coingecko.com/api/v3/simple/price?ids=${COIN_ID}&vs_currencies=${api_currency}"

    price_cache="$(get_price_cache_file)"
    cache_seconds="$(get_cache_seconds "$mode")"

    mkdir -p "$CACHE_DIR"

    if [[ -f "$price_cache" ]]; then
        if ! jq -e --arg coin "$COIN_ID" --arg cur "$api_currency" '.[$coin][$cur] | numbers' "$price_cache" >/dev/null 2>&1; then
            echo "Ignoring invalid cached price data: $(basename "$price_cache")" >&2
            rm -f "$price_cache"
        else
            age=$(( $(date +%s) - $(stat -c %Y "$price_cache") ))

            if (( age < cache_seconds )); then
                cat "$price_cache"
                return
            fi
        fi
    fi

    tmp_file="$(mktemp "${price_cache}.tmp.XXXXXX")" || return 1

    http_code="$(
        curl \
            --connect-timeout 10 \
            --max-time 20 \
            -sS \
            -w '%{http_code}' \
            "$price_api" \
            -o "$tmp_file" \
            2>/dev/null || true
    )"

    if [[ "$http_code" == "200" ]] &&
       jq \
           -e \
           --arg coin "$COIN_ID" \
           --arg cur "$api_currency" \
           '.[$coin][$cur] | numbers' \
           "$tmp_file" \
           >/dev/null 2>&1
    then
        mv -f "$tmp_file" "$price_cache"
        cat "$price_cache"
        return
    fi

    rm -f "$tmp_file"

    if [[ "$http_code" == "429" ]]; then
        echo "CoinGecko rate limit reached." >&2
    elif [[ -n "$http_code" && "$http_code" != "000" ]]; then
        echo "CoinGecko price request failed with HTTP $http_code." >&2
    else
        echo "CoinGecko price request failed." >&2
    fi

    if [[ -f "$price_cache" ]] &&
       jq -e --arg coin "$COIN_ID" --arg cur "$api_currency" '.[$coin][$cur] | numbers' "$price_cache" >/dev/null 2>&1
    then
        echo "Using cached $COIN $CURRENCY price data." >&2
        cat "$price_cache"
        return
    fi

    echo "Could not fetch $COIN_NAME price in $CURRENCY." >&2
    return 1
}


get_price() {
    local mode="${1:-}"

    local response
    local price
    local api_currency

    api_currency="$(get_currency_api_code)"
    response="$(get_price_json "$mode")" || return 1

    price="$(
        printf '%s' "$response" |
        jq \
            -r \
            --arg coin "$COIN_ID" \
            --arg cur "$api_currency" \
            '.[$coin][$cur] // empty'
    )"

    if [[ -z "$price" ]]; then
        echo "Could not get $COIN_NAME price." >&2
        return 1
    fi

    awk -v price="$price" 'BEGIN {
        if (price >= 100) {
            printf "%.2f\n", price
        } else if (price >= 1) {
            printf "%.4f\n", price
        } else {
            printf "%.6f\n", price
        }
    }'
}


get_chart_file() {
    local mode="${1:-}"

    local days
    local chart_cache
    local cache_seconds
    local age
    local count
    local api_currency
    local tmp_file
    local http_code

    days="$(get_days)"
    api_currency="$(get_currency_api_code)"

    chart_cache="$CACHE_DIR/${COIN}-chart-${days}d-${api_currency}.json"
    cache_seconds="$(get_cache_seconds "$mode")"

    mkdir -p "$CACHE_DIR"

    if [[ -f "$chart_cache" ]]; then
        if ! count="$(jq -er '.prices | arrays | length' "$chart_cache" 2>/dev/null)" ||
           [[ ! "$count" =~ ^[0-9]+$ ]] ||
           (( count < 2 ))
        then
            echo "Ignoring invalid cached chart data: $(basename "$chart_cache")" >&2
            rm -f "$chart_cache"
        else
            age=$(( $(date +%s) - $(stat -c %Y "$chart_cache") ))

            if (( age < cache_seconds )); then
                printf '%s\n' "$chart_cache"
                return
            fi
        fi
    fi

    tmp_file="$(mktemp "${chart_cache}.tmp.XXXXXX")" || return 1

    http_code="$(
        curl \
            --connect-timeout 10 \
            --max-time 20 \
            -sS \
            -w '%{http_code}' \
            "https://api.coingecko.com/api/v3/coins/${COIN_ID}/market_chart?vs_currency=${api_currency}&days=${days}" \
            -o "$tmp_file" \
            2>/dev/null || true
    )"

    if [[ "$http_code" == "200" ]] &&
       count="$(jq -er '.prices | arrays | length' "$tmp_file" 2>/dev/null)" &&
       [[ "$count" =~ ^[0-9]+$ ]] &&
       (( count >= 2 ))
    then
        mv -f "$tmp_file" "$chart_cache"
        printf '%s\n' "$chart_cache"
        return
    fi

    rm -f "$tmp_file"

    if [[ "$http_code" == "429" ]]; then
        echo "CoinGecko rate limit reached." >&2
    elif [[ -n "$http_code" && "$http_code" != "000" ]]; then
        echo "CoinGecko chart request failed with HTTP $http_code." >&2
    else
        echo "CoinGecko chart request failed." >&2
    fi

    if [[ -f "$chart_cache" ]] &&
       count="$(jq -er '.prices | arrays | length' "$chart_cache" 2>/dev/null)" &&
       [[ "$count" =~ ^[0-9]+$ ]] &&
       (( count >= 2 ))
    then
        echo "Using cached $COIN ${days}d $CURRENCY chart data." >&2
        printf '%s\n' "$chart_cache"
        return
    fi

    echo "Could not fetch $COIN_NAME chart data." >&2
    return 1
}


get_chart_data() {
    local mode="${1:-}"
    local chart_file

    chart_file="$(get_chart_file "$mode")" || return 1

    jq -r '.prices[][1]' "$chart_file"
}


get_range_change() {
    local mode="${1:-}"

    local chart_file
    local first_price
    local last_price

    chart_file="${2:-}"
    if [[ -z "$chart_file" ]]; then
        chart_file="$(get_chart_file "$mode")" || return 1
    fi

    first_price="$(jq -r '.prices[0][1]' "$chart_file")"
    last_price="$(jq -r '.prices[-1][1]' "$chart_file")"

    awk \
        -v first="$first_price" \
        -v last="$last_price" \
        'BEGIN {
            if (first == 0) {
                exit 1
            }

            print ((last - first) / first) * 100
        }'
}


get_change_color() {
    local change="$1"

    awk \
        -v change="$change" \
        -v green="$GREEN" \
        -v red="$RED" \
        'BEGIN {
            if (change >= 0) {
                print green
            } else {
                print red
            }
        }'
}


format_change() {
    local change="$1"

    awk -v change="$change" 'BEGIN {
        if (change >= 0) {
            printf "+%.2f%%\n", change
        } else {
            printf "%.2f%%\n", change
        }
    }'
}


make_graph_draw_args() {
    local mode="${1:-}"
    local chart_file="${2:-}"
    local data

    if [[ -n "$chart_file" ]]; then
        data="$(jq -r '.prices[][1]' "$chart_file")" || return 1
    else
        data="$(get_chart_data "$mode")" || return 1
    fi

    # One linear pass for extrema and one for segments; no per-point processes.
    awk -v width="$(scale_x 1400)" -v height="$(scale_y 260)" \
        -v start_x="$(scale_x 260)" -v start_y="$(scale_y 660)" \
        -v stroke_width="$(scale_font 4)" -v green="$GREEN" -v red="$RED" '
        function y(price) {
            return max == min ? start_y : int(start_y + height - ((price - min) / (max - min) * height))
        }
        NF {
            prices[++count] = $1 + 0
            if (count == 1 || $1 + 0 < min) min = $1 + 0
            if (count == 1 || $1 + 0 > max) max = $1 + 0
        }
        END {
            if (count < 2) exit 1
            for (i = 2; i <= count; i++) {
                x1 = start_x + int((i - 2) * width / (count - 1))
                x2 = start_x + int((i - 1) * width / (count - 1))
                color = prices[i] >= prices[i - 1] ? green : red
                printf "-stroke%c%s%c-strokewidth%c%d%c-fill%cnone%c-draw%cline %d,%d %d,%d%c", \
                    0, color, 0, 0, stroke_width, 0, 0, 0, 0, x1, y(prices[i - 1]), x2, y(prices[i]), 0
            }
        }
    ' <<< "$data"
}

