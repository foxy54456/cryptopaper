#!/usr/bin/env bash

set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cryptopaper"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cryptopaper"
CONFIG_FILE="$CONFIG_DIR/config"

DEFAULT_CURRENCY="USD"
CURRENCY="$DEFAULT_CURRENCY"
PRICE_CACHE="$CACHE_DIR/market.json"
SWAYBG_PID_FILE="$CACHE_DIR/swaybg.pid"

DEFAULT_UPDATE_TIME="2m"

OUTPUT=""

GREEN="#00c853"
RED="#ff5252"
WHITE="#ffffff"
BACKGROUND="#090909"
GRAY="#aaaaaa"

COMMAND="${1:-help}"
TIME_RANGE="${2:-1d}"
UPDATE_TIME="${3:-$DEFAULT_UPDATE_TIME}"

RANGE_LABEL="${TIME_RANGE^^}"

BASE_WIDTH=1920
BASE_HEIGHT=1080

SCREEN_WIDTH="$BASE_WIDTH"
SCREEN_HEIGHT="$BASE_HEIGHT"


load_currency() {
    local value=""

    if [[ -f "$CONFIG_FILE" ]]; then
        value="$(awk -F= '$1 == "currency" { print $2; exit }' "$CONFIG_FILE" 2>/dev/null || true)"
        value="${value^^}"
    fi

    case "$value" in
        USD|EUR|GBP) CURRENCY="$value" ;;
        *) CURRENCY="$DEFAULT_CURRENCY" ;;
    esac
}


get_currency_api_code() {
    printf '%s\n' "${CURRENCY,,}"
}


get_currency_symbol() {
    case "$CURRENCY" in
        USD) printf '$\n' ;;
        EUR) printf '€\n' ;;
        GBP) printf '£\n' ;;
    esac
}


set_currency() {
    local value="${1:-}"
    value="${value^^}"

    case "$value" in
        USD|EUR|GBP) ;;
        *)
            echo "Unsupported currency: ${value:-<empty>}" >&2
            echo "Supported currencies: USD, EUR, GBP" >&2
            return 1
            ;;
    esac

    mkdir -p "$CONFIG_DIR"
    printf 'currency=%s\n' "$value" > "$CONFIG_FILE"
    CURRENCY="$value"

    # Cached market/chart data is currency-specific, so clear it when switching.
    clear_cache >/dev/null

    echo "Currency set to $CURRENCY ($(get_currency_symbol))."
}


get_days() {
    if [[ "$TIME_RANGE" =~ ^([1-9][0-9]*)d$ ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "Invalid time range: $TIME_RANGE" >&2
        echo "Use something like: 1d, 7d, 16d, 30d" >&2
        return 1
    fi
}


parse_update_time() {
    local value="$1"

    if [[ "$value" =~ ^([1-9][0-9]*)(s|m|h)$ ]]; then
        local amount="${BASH_REMATCH[1]}"
        local unit="${BASH_REMATCH[2]}"

        case "$unit" in
            s)
                echo "$amount"
                ;;
            m)
                echo $(( amount * 60 ))
                ;;
            h)
                echo $(( amount * 3600 ))
                ;;
        esac
    else
        echo "Invalid update time: $value" >&2
        echo "Use something like: 30s, 2m, 10m, 1h" >&2
        return 1
    fi
}


format_update_time() {
    local seconds="$1"

    if (( seconds % 3600 == 0 )); then
        local hours=$(( seconds / 3600 ))

        if (( hours == 1 )); then
            echo "1 hour"
        else
            echo "$hours hours"
        fi

    elif (( seconds % 60 == 0 )); then
        local minutes=$(( seconds / 60 ))

        if (( minutes == 1 )); then
            echo "1 minute"
        else
            echo "$minutes minutes"
        fi

    else
        if (( seconds == 1 )); then
            echo "1 second"
        else
            echo "$seconds seconds"
        fi
    fi
}


format_age() {
    local seconds="$1"

    if (( seconds < 60 )); then
        echo "${seconds}s"

    elif (( seconds < 3600 )); then
        echo "$(( seconds / 60 ))m"

    elif (( seconds < 86400 )); then
        echo "$(( seconds / 3600 ))h"

    else
        echo "$(( seconds / 86400 ))d"
    fi
}


validate_args() {
    case "$COMMAND" in
        price)
            if (( $# != 1 )); then
                echo "Usage: ./cryptopaper price" >&2
                exit 1
            fi
            ;;

        set)
            if (( $# > 2 )); then
                echo "Usage: ./cryptopaper set [days]" >&2
                exit 1
            fi

            get_days >/dev/null || exit 1
            ;;

        run)
            if (( $# > 3 )); then
                echo "Usage: ./cryptopaper run [days] [update-time]" >&2
                exit 1
            fi

            get_days >/dev/null || exit 1
            parse_update_time "$UPDATE_TIME" >/dev/null || exit 1
            ;;

        cur)
            if (( $# != 2 )); then
                echo "Usage: ./cryptopaper cur USD|EUR|GBP" >&2
                exit 1
            fi
            ;;

        cache|clear-cache|info)
            if (( $# != 1 )); then
                echo "Usage: ./cryptopaper $COMMAND" >&2
                exit 1
            fi
            ;;

        help|--help|-h)
            ;;

        *)
            ;;
    esac
}


set_screen_size() {
    local width="$1"
    local height="$2"

    if (( width >= 640 && height >= 480 )); then
        SCREEN_WIDTH="$width"
        SCREEN_HEIGHT="$height"
        return 0
    fi

    return 1
}


get_screen_dimensions() {
    local size=""
    local desktop

    SCREEN_WIDTH="$BASE_WIDTH"
    SCREEN_HEIGHT="$BASE_HEIGHT"

    desktop="${XDG_CURRENT_DESKTOP:-}"
    desktop="${desktop^^}"

    #
    # Manual testing override
    #
    if [[ -n "${CRYPTOPAPER_RESOLUTION:-}" ]]; then
        if [[ "$CRYPTOPAPER_RESOLUTION" =~ ^([0-9]+)x([0-9]+)$ ]]; then
            if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                return
            fi
        fi

        echo "Invalid CRYPTOPAPER_RESOLUTION: $CRYPTOPAPER_RESOLUTION" >&2
        return 1
    fi

    #
    # KDE Plasma
    #
    if [[ "$desktop" == *"KDE"* || "$desktop" == *"PLASMA"* ]]; then
        if command -v kscreen-doctor >/dev/null 2>&1; then
            size="$(
                timeout 2s kscreen-doctor -o 2>/dev/null |
                awk '
                    /Geometry:/ {
                        if (match($0, /[0-9]+x[0-9]+/)) {
                            print substr($0, RSTART, RLENGTH)
                            exit
                        }
                    }
                '
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    #
    # Hyprland
    #
    if [[ "$desktop" == *"HYPRLAND"* ||
          -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
    then
        if command -v hyprctl >/dev/null 2>&1; then
            size="$(
                timeout 2s hyprctl monitors -j 2>/dev/null |
                jq -r '
                    first(
                        .[] |
                        select(.focused == true) |
                        "\(.width)x\(.height)"
                    ) // empty
                ' 2>/dev/null
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    #
    # Sway
    #
    if [[ "$desktop" == *"SWAY"* || -n "${SWAYSOCK:-}" ]]; then
        if command -v swaymsg >/dev/null 2>&1; then
            size="$(
                timeout 2s swaymsg -t get_outputs -r 2>/dev/null |
                jq -r '
                    first(
                        .[] |
                        select(.focused == true) |
                        "\(.rect.width)x\(.rect.height)"
                    ) // empty
                ' 2>/dev/null
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    #
    # Generic X11 detection
    #
    if [[ "${XDG_SESSION_TYPE:-}" == "x11" ]]; then
        if command -v xrandr >/dev/null 2>&1; then
            size="$(
                xrandr 2>/dev/null |
                awk '
                    / connected primary / {
                        if (match($0, /[0-9]+x[0-9]+\+/)) {
                            value = substr($0, RSTART, RLENGTH)
                            sub(/\+$/, "", value)
                            print value
                            exit
                        }
                    }

                    / connected / {
                        if (fallback == "" && match($0, /[0-9]+x[0-9]+\+/)) {
                            fallback = substr($0, RSTART, RLENGTH)
                            sub(/\+$/, "", fallback)
                        }
                    }

                    END {
                        if (fallback != "") {
                            print fallback
                        }
                    }
                ' |
                head -n 1
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi

        if command -v xdpyinfo >/dev/null 2>&1; then
            size="$(
                xdpyinfo 2>/dev/null |
                awk '/dimensions:/ { print $2; exit }'
            )"

            if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                if set_screen_size "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then
                    return
                fi
            fi
        fi
    fi

    #
    # Safe fallback
    #
    SCREEN_WIDTH="$BASE_WIDTH"
    SCREEN_HEIGHT="$BASE_HEIGHT"
}


scale_x() {
    local value="$1"

    awk \
        -v value="$value" \
        -v width="$SCREEN_WIDTH" \
        -v base="$BASE_WIDTH" \
        'BEGIN {
            result = int((value * width / base) + 0.5)

            if (result < 1) {
                result = 1
            }

            print result
        }'
}


scale_y() {
    local value="$1"

    awk \
        -v value="$value" \
        -v height="$SCREEN_HEIGHT" \
        -v base="$BASE_HEIGHT" \
        'BEGIN {
            result = int((value * height / base) + 0.5)

            if (result < 1) {
                result = 1
            }

            print result
        }'
}


scale_font() {
    local value="$1"

    awk \
        -v value="$value" \
        -v width="$SCREEN_WIDTH" \
        -v height="$SCREEN_HEIGHT" \
        -v base_width="$BASE_WIDTH" \
        -v base_height="$BASE_HEIGHT" \
        'BEGIN {
            x_scale = width / base_width
            y_scale = height / base_height

            if (x_scale < y_scale) {
                scale = x_scale
            } else {
                scale = y_scale
            }

            result = int((value * scale) + 0.5)

            if (result < 1) {
                result = 1
            }

            print result
        }'
}


get_cache_seconds() {
    local mode="${1:-}"

    if [[ "$mode" == "run" ]]; then
        parse_update_time "$UPDATE_TIME"
    else
        echo 120
    fi
}


get_price_json() {
    local mode="${1:-}"
    local cache_seconds
    local age
    local api_currency
    local price_api

    api_currency="$(get_currency_api_code)"
    price_api="https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=${api_currency}"

    cache_seconds="$(get_cache_seconds "$mode")"

    mkdir -p "$CACHE_DIR"

    if [[ -f "$PRICE_CACHE" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$PRICE_CACHE") ))

        if (( age < cache_seconds )); then
            cat "$PRICE_CACHE"
            return
        fi
    fi

    if curl \
        --connect-timeout 10 \
        --max-time 20 \
        -fsS \
        "$price_api" \
        -o "$PRICE_CACHE.tmp"
    then
        if jq -e --arg cur "$api_currency" '.bitcoin[$cur]' "$PRICE_CACHE.tmp" >/dev/null 2>&1; then
            mv "$PRICE_CACHE.tmp" "$PRICE_CACHE"
            cat "$PRICE_CACHE"
            return
        fi

        rm -f "$PRICE_CACHE.tmp"
    fi

    if [[ -f "$PRICE_CACHE" ]]; then
        echo "Price API unavailable, using cached data." >&2
        cat "$PRICE_CACHE"
        return
    fi

    echo "Could not fetch Bitcoin price." >&2
    return 1
}


get_price() {
    local mode="${1:-}"
    local response
    local price
    local api_currency

    api_currency="$(get_currency_api_code)"
    response="$(get_price_json "$mode")" || return 1

    price="$(printf '%s' "$response" | jq -r --arg cur "$api_currency" '.bitcoin[$cur] // empty')"

    if [[ -z "$price" ]]; then
        echo "Could not get Bitcoin price." >&2
        return 1
    fi

    printf '%.2f\n' "$price"
}


get_chart_file() {
    local mode="${1:-}"

    local days
    local chart_cache
    local cache_seconds
    local age
    local count

    days="$(get_days)"
    chart_cache="$CACHE_DIR/chart-${days}d-${CURRENCY,,}.json"
    cache_seconds="$(get_cache_seconds "$mode")"

    mkdir -p "$CACHE_DIR"

    if [[ -f "$chart_cache" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$chart_cache") ))

        if (( age < cache_seconds )); then
            printf '%s\n' "$chart_cache"
            return
        fi
    fi

    if curl \
        --connect-timeout 10 \
        --max-time 20 \
        -fsS \
        "https://api.coingecko.com/api/v3/coins/bitcoin/market_chart?vs_currency=$(get_currency_api_code)&days=${days}" \
        -o "$chart_cache.tmp"
    then
        count="$(jq '.prices | length' "$chart_cache.tmp")"

        if [[ "$count" =~ ^[0-9]+$ ]] && (( count >= 2 )); then
            mv "$chart_cache.tmp" "$chart_cache"
            printf '%s\n' "$chart_cache"
            return
        fi

        rm -f "$chart_cache.tmp"
    fi

    if [[ -f "$chart_cache" ]]; then
        echo "Chart API unavailable, using cached ${days}d data." >&2
        printf '%s\n' "$chart_cache"
        return
    fi

    echo "Could not fetch chart data." >&2
    return 1
}


get_chart_data() {
    local mode="${1:-}"
    local chart_file

    chart_file="$(get_chart_file "$mode")" || return 1

    jq -r '.prices[][1]' "$chart_file"
}


get_range_change() {
    local mode="${1:-}"

    local chart_file
    local first_price
    local last_price

    chart_file="$(get_chart_file "$mode")" || return 1

    first_price="$(jq -r '.prices[0][1]' "$chart_file")"
    last_price="$(jq -r '.prices[-1][1]' "$chart_file")"

    awk \
        -v first="$first_price" \
        -v last="$last_price" \
        'BEGIN {
            if (first == 0) {
                exit 1
            }

            print ((last - first) / first) * 100
        }'
}


get_change_color() {
    local change="$1"

    awk \
        -v change="$change" \
        -v green="$GREEN" \
        -v red="$RED" \
        'BEGIN {
            if (change >= 0) {
                print green
            } else {
                print red
            }
        }'
}


format_change() {
    local change="$1"

    awk -v change="$change" 'BEGIN {
        if (change >= 0) {
            printf "+%.2f%%\n", change
        } else {
            printf "%.2f%%\n", change
        }
    }'
}


make_graph_draw_args() {
    local mode="${1:-}"

    local -a prices
    local -a args=()

    local min
    local max

    local width
    local height
    local start_x
    local start_y
    local stroke_width

    local count
    local i

    local price
    local prev_price

    local x1
    local x2
    local y1
    local y2

    local color

    width="$(scale_x 1400)"
    height="$(scale_y 260)"
    start_x="$(scale_x 260)"
    start_y="$(scale_y 660)"
    stroke_width="$(scale_font 4)"

    mapfile -t prices < <(get_chart_data "$mode")

    count="${#prices[@]}"

    if (( count < 2 )); then
        return 1
    fi

    min="$(
        printf '%s\n' "${prices[@]}" |
        sort -n |
        head -n 1
    )"

    max="$(
        printf '%s\n' "${prices[@]}" |
        sort -n |
        tail -n 1
    )"

    price_to_y() {
        awk \
            -v price="$1" \
            -v min="$min" \
            -v max="$max" \
            -v start="$start_y" \
            -v height="$height" \
            'BEGIN {
                if (max == min) {
                    print start
                } else {
                    print int(start + height - ((price - min) / (max - min) * height))
                }
            }'
    }

    for (( i=1; i<count; i++ )); do
        prev_price="${prices[$((i - 1))]}"
        price="${prices[$i]}"

        x1=$(( start_x + ((i - 1) * width / (count - 1)) ))
        x2=$(( start_x + (i * width / (count - 1)) ))

        y1="$(price_to_y "$prev_price")"
        y2="$(price_to_y "$price")"

        color="$(
            awk \
                -v curr="$price" \
                -v prev="$prev_price" \
                -v green="$GREEN" \
                -v red="$RED" \
                'BEGIN {
                    if (curr >= prev) {
                        print green
                    } else {
                        print red
                    }
                }'
        )"

        args+=(
            -stroke "$color"
            -strokewidth "$stroke_width"
            -fill none
            -draw "line ${x1},${y1} ${x2},${y2}"
        )
    done

    printf '%s\0' "${args[@]}"
}


show_price() {
    local price

    price="$(get_price)"

    printf 'Bitcoin: %s%s\n' "$(get_currency_symbol)" "$price"
}


show_cache() {
    local now
    local age
    local found_chart=false
    local file
    local name

    now="$(date +%s)"

    echo "cryptopaper cache"
    echo

    if [[ ! -d "$CACHE_DIR" ]]; then
        echo "No cache directory exists yet."
        return
    fi

    if [[ -f "$PRICE_CACHE" ]]; then
        age=$(( now - $(stat -c %Y "$PRICE_CACHE") ))

        echo "Price:"
        echo "  market.json — $(format_age "$age") old"
    else
        echo "Price:"
        echo "  not cached"
    fi

    echo
    echo "Charts:"

    while IFS= read -r file; do
        found_chart=true

        age=$(( now - $(stat -c %Y "$file") ))
        name="$(basename "$file")"

        echo "  $name — $(format_age "$age") old"
    done < <(
        find "$CACHE_DIR" \
            -maxdepth 1 \
            -type f \
            -name 'chart-*d-*.json' \
            -print 2>/dev/null |
        sort
    )

    if [[ "$found_chart" == false ]]; then
        echo "  no chart data cached"
    fi

    echo
    echo "Cache directory:"
    echo "  $CACHE_DIR"
}


clear_cache() {
    mkdir -p "$CACHE_DIR"

    rm -f \
        "$PRICE_CACHE" \
        "$PRICE_CACHE.tmp"

    find "$CACHE_DIR" \
        -maxdepth 1 \
        -type f \
        \( \
            -name 'chart-*d-*.json' \
            -o -name 'chart-*d.json.tmp' \
        \) \
        -delete

    echo "Cryptopaper API cache cleared."
}


make_wallpaper() {
    local mode="${1:-}"

    local price
    local change
    local change_text
    local change_color
    local currency_symbol

    local title_size
    local price_size
    local change_size
    local label_size

    local title_offset
    local price_offset
    local change_offset
    local label_offset

    local -a graph_args

    get_screen_dimensions

    OUTPUT="$CACHE_DIR/wallpaper-$(date +%s).png"

    price="$(get_price "$mode")"
    change="$(get_range_change "$mode")"

    change_text="$(format_change "$change")"
    change_color="$(get_change_color "$change")"
    currency_symbol="$(get_currency_symbol)"

    mkdir -p "$CACHE_DIR"

    mapfile -d '' -t graph_args < <(make_graph_draw_args "$mode")

    if (( ${#graph_args[@]} == 0 )); then
        echo "Could not generate graph." >&2
        return 1
    fi

    title_size="$(scale_font 48)"
    price_size="$(scale_font 140)"
    change_size="$(scale_font 48)"
    label_size="$(scale_font 28)"

    title_offset="$(scale_y 120)"
    price_offset="$(scale_y 200)"
    change_offset="$(scale_y 90)"
    label_offset="$(scale_y 110)"

    magick \
        -size "${SCREEN_WIDTH}x${SCREEN_HEIGHT}" \
        "xc:${BACKGROUND}" \
        -gravity north \
        -fill "$WHITE" \
        -font DejaVu-Sans \
        -pointsize "$title_size" \
        -annotate "+0+${title_offset}" "BITCOIN" \
        -gravity center \
        -fill "$WHITE" \
        -font DejaVu-Sans \
        -pointsize "$price_size" \
        -annotate "+0-${price_offset}" "${currency_symbol}${price}" \
        -gravity center \
        -fill "$change_color" \
        -font DejaVu-Sans \
        -pointsize "$change_size" \
        -annotate "+0-${change_offset}" "$change_text" \
        "${graph_args[@]}" \
        -gravity south \
        -fill "$GRAY" \
        -stroke none \
        -font DejaVu-Sans \
        -pointsize "$label_size" \
        -annotate "+0+${label_offset}" "$RANGE_LABEL" \
        "$OUTPUT"

    printf 'Wallpaper saved to %s\n' "$OUTPUT"
    printf 'Resolution: %sx%s\n' "$SCREEN_WIDTH" "$SCREEN_HEIGHT"
}


try_hyprpaper() {
    if ! command -v hyprctl >/dev/null 2>&1; then
        return 1
    fi

    if ! pgrep -x hyprpaper >/dev/null 2>&1; then
        return 1
    fi

    if hyprctl hyprpaper reload ",$OUTPUT" >/dev/null 2>&1; then
        echo "Wallpaper backend: hyprpaper"
        return 0
    fi

    return 1
}


try_swww() {
    if ! command -v swww >/dev/null 2>&1; then
        return 1
    fi

    if ! swww query >/dev/null 2>&1; then
        if command -v swww-daemon >/dev/null 2>&1; then
            swww-daemon >/dev/null 2>&1 &
            sleep 0.5
        fi
    fi

    if swww img "$OUTPUT" >/dev/null 2>&1; then
        echo "Wallpaper backend: swww"
        return 0
    fi

    return 1
}


stop_cryptopaper_swaybg() {
    local pid

    if [[ ! -f "$SWAYBG_PID_FILE" ]]; then
        return
    fi

    pid="$(cat "$SWAYBG_PID_FILE" 2>/dev/null || true)"

    if [[ "$pid" =~ ^[0-9]+$ ]] &&
       kill -0 "$pid" 2>/dev/null
    then
        kill "$pid" 2>/dev/null || true
    fi

    rm -f "$SWAYBG_PID_FILE"
}


try_swaybg() {
    local pid

    if ! command -v swaybg >/dev/null 2>&1; then
        return 1
    fi

    stop_cryptopaper_swaybg

    swaybg \
        -i "$OUTPUT" \
        -m fill \
        >/dev/null 2>&1 &

    pid=$!

    sleep 0.2

    if kill -0 "$pid" 2>/dev/null; then
        echo "$pid" > "$SWAYBG_PID_FILE"
        echo "Wallpaper backend: swaybg"
        return 0
    fi

    return 1
}


try_xfce() {
    local property
    local found=false
    local monitor=""
    local workspace="0"
    local default_property=""

    if ! command -v xfconf-query >/dev/null 2>&1; then
        return 1
    fi

    #
    # Try existing XFCE wallpaper properties.
    #
    while IFS= read -r property; do
        [[ -z "$property" ]] && continue

        if xfconf-query \
            -c xfce4-desktop \
            -p "$property" \
            -s "$OUTPUT" \
            >/dev/null 2>&1
        then
            found=true
        fi
    done < <(
        xfconf-query -c xfce4-desktop -l 2>/dev/null |
        grep -E '/(last-image|image-path|last-single-image)$' || true
    )

    if [[ "$found" == true ]]; then
        echo "Wallpaper backend: XFCE"
        return 0
    fi

    #
    # Fresh XFCE profile.
    #
    if command -v xrandr >/dev/null 2>&1; then
        monitor="$(
            xrandr --query 2>/dev/null |
            awk '
                / connected primary / {
                    print $1
                    exit
                }

                / connected / && fallback == "" {
                    fallback = $1
                }

                END {
                    if (fallback != "") {
                        print fallback
                    }
                }
            ' |
            head -n 1
        )"
    fi

    if [[ -n "$monitor" ]]; then
        default_property="/backdrop/screen0/monitor${monitor}/workspace${workspace}/last-image"
    else
        default_property="/backdrop/screen0/monitor0/workspace${workspace}/last-image"
    fi

    if xfconf-query \
        -c xfce4-desktop \
        -p "$default_property" \
        -n \
        -t string \
        -s "$OUTPUT" \
        >/dev/null 2>&1
    then
        echo "Wallpaper backend: XFCE"
        return 0
    fi

    if xfconf-query \
        -c xfce4-desktop \
        -p "$default_property" \
        -s "$OUTPUT" \
        >/dev/null 2>&1
    then
        echo "Wallpaper backend: XFCE"
        return 0
    fi

    return 1
}


try_lxqt() {
    if ! command -v pcmanfm-qt >/dev/null 2>&1; then
        return 1
    fi

    if pcmanfm-qt \
        --set-wallpaper="$OUTPUT" \
        >/dev/null 2>&1
    then
        echo "Wallpaper backend: LXQt"
        return 0
    fi

    return 1
}


get_wallpaper_backend_name() {
    local desktop

    desktop="${XDG_CURRENT_DESKTOP:-}"
    desktop="${desktop^^}"

    if [[ "$desktop" == *"KDE"* || "$desktop" == *"PLASMA"* ]]; then
        if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
            echo "KDE Plasma"
            return
        fi
    fi

    if [[ "$desktop" == *"GNOME"* ]]; then
        if command -v gsettings >/dev/null 2>&1; then
            echo "GNOME"
            return
        fi
    fi

    if [[ "$desktop" == *"CINNAMON"* ]]; then
        if command -v gsettings >/dev/null 2>&1; then
            echo "Cinnamon"
            return
        fi
    fi

    if [[ "$desktop" == *"MATE"* ]]; then
        if command -v gsettings >/dev/null 2>&1; then
            echo "MATE"
            return
        fi
    fi

    if [[ "$desktop" == *"XFCE"* ]]; then
        if command -v xfconf-query >/dev/null 2>&1; then
            echo "XFCE"
            return
        fi
    fi

    if [[ "$desktop" == *"LXQT"* ]]; then
        if command -v pcmanfm-qt >/dev/null 2>&1; then
            echo "LXQt"
            return
        fi
    fi

    if [[ "$desktop" == *"HYPRLAND"* ||
          -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
    then
        if command -v hyprpaper >/dev/null 2>&1; then
            echo "hyprpaper"
            return
        fi

        if command -v swww >/dev/null 2>&1; then
            echo "swww"
            return
        fi

        if command -v swaybg >/dev/null 2>&1; then
            echo "swaybg"
            return
        fi
    fi

    if [[ "$desktop" == *"SWAY"* ||
          -n "${SWAYSOCK:-}" ]]
    then
        if command -v swaybg >/dev/null 2>&1; then
            echo "swaybg"
            return
        fi

        if command -v swww >/dev/null 2>&1; then
            echo "swww"
            return
        fi
    fi

    if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
        if command -v swww >/dev/null 2>&1; then
            echo "swww"
            return
        fi

        if command -v swaybg >/dev/null 2>&1; then
            echo "swaybg"
            return
        fi
    fi

    if command -v feh >/dev/null 2>&1; then
        echo "feh"
        return
    fi

    echo "none"
}


show_info() {
    local backend

    get_screen_dimensions
    backend="$(get_wallpaper_backend_name)"

    echo "cryptopaper info"
    echo
    echo "Resolution: ${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
    echo "Desktop: ${XDG_CURRENT_DESKTOP:-unknown}"
    echo "Session: ${XDG_SESSION_TYPE:-unknown}"
    echo "Wallpaper backend: $backend"
    echo "Currency: $CURRENCY ($(get_currency_symbol))"
}


set_wallpaper_backend() {
    local desktop

    desktop="${XDG_CURRENT_DESKTOP:-}"
    desktop="${desktop^^}"

    #
    # KDE Plasma
    #
    if [[ "$desktop" == *"KDE"* || "$desktop" == *"PLASMA"* ]]; then
        if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
            if plasma-apply-wallpaperimage "$OUTPUT"; then
                echo "Wallpaper backend: KDE Plasma"
                return 0
            fi
        fi

        echo "Could not set the KDE Plasma wallpaper." >&2
        return 1
    fi

    #
    # GNOME
    #
    if [[ "$desktop" == *"GNOME"* ]]; then
        if command -v gsettings >/dev/null 2>&1; then
            gsettings set \
                org.gnome.desktop.background \
                picture-uri \
                "file://$OUTPUT"

            gsettings set \
                org.gnome.desktop.background \
                picture-uri-dark \
                "file://$OUTPUT" \
                >/dev/null 2>&1 || true

            gsettings set \
                org.gnome.desktop.background \
                picture-options \
                "zoom" \
                >/dev/null 2>&1 || true

            echo "Wallpaper backend: GNOME"
            return 0
        fi

        echo "Could not find gsettings for GNOME." >&2
        return 1
    fi

    #
    # Cinnamon
    #
    if [[ "$desktop" == *"CINNAMON"* ]]; then
        if command -v gsettings >/dev/null 2>&1; then
            gsettings set \
                org.cinnamon.desktop.background \
                picture-uri \
                "file://$OUTPUT"

            gsettings set \
                org.cinnamon.desktop.background \
                picture-options \
                "scaled"

            echo "Wallpaper backend: Cinnamon"
            return 0
        fi

        echo "Could not find gsettings for Cinnamon." >&2
        return 1
    fi

    #
    # MATE
    #
    if [[ "$desktop" == *"MATE"* ]]; then
        if command -v gsettings >/dev/null 2>&1; then
            gsettings set \
                org.mate.background \
                picture-filename \
                "$OUTPUT"

            gsettings set \
                org.mate.background \
                picture-options \
                "scaled"

            echo "Wallpaper backend: MATE"
            return 0
        fi

        echo "Could not find gsettings for MATE." >&2
        return 1
    fi

    #
    # XFCE
    #
    if [[ "$desktop" == *"XFCE"* ]]; then
        if try_xfce; then
            return 0
        fi

        echo "Could not set the XFCE wallpaper." >&2
        return 1
    fi

    #
    # LXQt
    #
    if [[ "$desktop" == *"LXQT"* ]]; then
        if try_lxqt; then
            return 0
        fi

        echo "Could not set the LXQt wallpaper." >&2
        return 1
    fi

    #
    # Hyprland
    #
    if [[ "$desktop" == *"HYPRLAND"* ||
          -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
    then
        if try_hyprpaper; then
            return 0
        fi

        if try_swww; then
            return 0
        fi

        if try_swaybg; then
            return 0
        fi

        echo "No supported Hyprland wallpaper backend found." >&2
        echo "Install hyprpaper, swww, or swaybg." >&2
        return 1
    fi

    #
    # Sway
    #
    if [[ "$desktop" == *"SWAY"* ||
          -n "${SWAYSOCK:-}" ]]
    then
        if try_swaybg; then
            return 0
        fi

        if try_swww; then
            return 0
        fi

        echo "No supported Sway wallpaper backend found." >&2
        echo "Install swaybg or swww." >&2
        return 1
    fi

    #
    # Generic Wayland fallback
    #
    if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
        if try_swww; then
            return 0
        fi

        if try_swaybg; then
            return 0
        fi
    fi

    #
    # Generic X11 fallback
    #
    if command -v feh >/dev/null 2>&1; then
        if feh --bg-fill "$OUTPUT"; then
            echo "Wallpaper backend: feh"
            return 0
        fi
    fi

    echo "No supported wallpaper backend found." >&2
    echo >&2
    echo "Supported backends:" >&2
    echo "  KDE Plasma  - plasma-apply-wallpaperimage" >&2
    echo "  GNOME       - gsettings" >&2
    echo "  Cinnamon    - gsettings" >&2
    echo "  MATE        - gsettings" >&2
    echo "  XFCE        - xfconf-query" >&2
    echo "  LXQt        - pcmanfm-qt" >&2
    echo "  Hyprland    - hyprpaper, swww, or swaybg" >&2
    echo "  Sway        - swaybg or swww" >&2
    echo "  X11         - feh" >&2

    return 1
}


set_wallpaper() {
    local mode="${1:-}"

    make_wallpaper "$mode"

    if ! set_wallpaper_backend; then
        return 1
    fi

    find "$CACHE_DIR" \
        -name 'wallpaper-*.png' \
        -type f \
        -mmin +10 \
        -delete

    printf 'Wallpaper updated.\n'
}


run_wallpaper() {
    local update_seconds
    local update_label

    update_seconds="$(parse_update_time "$UPDATE_TIME")"
    update_label="$(format_update_time "$update_seconds")"

    echo "Starting cryptopaper..."
    echo "Range: $RANGE_LABEL"
    echo "Updating every $update_label."
    echo "Press Ctrl+C to stop."
    echo

    trap '
        echo
        echo "cryptopaper stopped."
        exit 0
    ' INT TERM

    while true; do
        if ! set_wallpaper "run"; then
            echo "Update failed. Retrying in $update_label." >&2
        fi

        sleep "$update_seconds"
    done
}


